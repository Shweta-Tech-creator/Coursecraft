digraph CourseCraftActivity {
  graph [rankdir=TB, splines=ortho, nodesep=0.38, ranksep=0.58, pad=0.18, bgcolor="white", fontname="Arial", fontsize=16, labelloc="t", label="CourseCraft learner journey"];
  node [shape=box, style="rounded,filled", fillcolor="#EEF4FA", color="#315A7D", fontname="Arial", fontsize=12, margin="0.12,0.08"];
  edge [color="#52677D", fontname="Arial", fontsize=10, arrowsize=0.75];
  start [shape=circle, label="Start", width=0.6, height=0.6, fillcolor="#DCE8F4"];
  endok [shape=oval, label="Certificate available", fillcolor="#DDEEDD"];
  endno [shape=oval, label="End / retry later", fillcolor="#F6E6E4"];
  browse [label="Browse catalogue"];
  select [label="Select course"];
  enrol [label="Create pending enrolment"];
  paid [shape=diamond, style=filled, label="Payment\nverified?", fillcolor="#FFF2CC"];
  paymentfail [label="Show failure / retry\n(no access)"];
  access [shape=diamond, style=filled, label="Access\nauthorised?", fillcolor="#FFF2CC"];
  deny [label="Show access message"];
  video [shape=diamond, style=filled, label="Video\navailable?", fillcolor="#FFF2CC"];
  retry [label="Show playback error / retry"];
  watch [label="Watch required lesson"];
  progress [label="Record lesson completion"];
  complete [shape=diamond, style=filled, label="All required\nlessons complete?", fillcolor="#FFF2CC"];
  quiz [label="Submit quiz"];
  passed [shape=diamond, style=filled, label="Score meets\nconfigured threshold?", fillcolor="#FFF2CC"];
  retake [label="Show result; follow\napproved retake policy"];
  eligibility [label="Check paid enrolment +\n100% completion + quiz pass"];
  issue [label="Issue / return unique\ncertificate"];
  start -> browse -> select -> enrol -> paid;
  paid -> paymentfail [label="No"];
  paid -> access [label="Yes"];
  paymentfail -> endno;
  access -> deny [label="No"];
  access -> video [label="Yes"];
  deny -> endno;
  video -> retry [label="No"];
  video -> watch [label="Yes"];
  retry -> video [label="Retry"];
  watch -> progress -> complete;
  complete -> access [label="No: continue lessons"];
  complete -> quiz [label="Yes"];
  quiz -> passed;
  passed -> retake [label="No"];
  passed -> eligibility [label="Yes"];
  retake -> endno;
  eligibility -> issue -> endok;
  {rank=same; start; browse; select; enrol; paid;}
  {rank=same; paymentfail; access; video; watch;}
  {rank=same; endno; deny; retry; progress; complete;}
  {rank=same; quiz; passed; retake; eligibility; issue; endok;}
}
